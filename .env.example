# Copie este arquivo para .env e ajuste os valores do seu domínio.
RP_ID=localhost
ORIGIN=http://localhost:8080
RP_NAME=Meu JeffGyn
# UID(s) de administradores, separados por vírgula. Configure após criar o perfil proprietário.
ADMIN_UIDS=
# Opcional: exigir código de convite para novos cadastros.
INVITE_ONLY=false
# Integração do gerador de treinos com IA. Nunca coloque esta chave no frontend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
